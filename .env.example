# ====================================================================
# GuestVerify Environment Configuration
# ====================================================================

# AI Operating Mode: "mock" | "bedrock"
# - mock: rule-based fake decision engine (ZERO AWS setup needed)
# - bedrock: real Anthropic Claude model on Amazon Bedrock
AI_MODE=mock

# Server Port
PORT=3001

# AWS Bedrock Configuration (required ONLY when AI_MODE=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=optional_session_token_if_using_sts

# Bedrock Model ID
# Recommended options:
# - anthropic.claude-3-haiku-20240307-v1:0 (Fast & cost-effective)
# - anthropic.claude-3-5-sonnet-20241022-v2:0 (High intelligence)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
